---
import "../styles/global.css";
// Layout Imports
import { ModeToggle } from "@/components/ModeToggle";
import { Navigation } from "../components/Navbar";

// UI Imports
import { Button } from "@/components/ui/button";

// Icon Imports
import { ChevronUp } from "lucide-react";

// Scripts
const { content } = Astro.props;
const currentYear = new Date().getFullYear();
---

<html lang="en">
  <!-- https://vibeui.online/ -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="generator" content={Astro.generator} />
    <title>{content.title}</title>
  </head>
  <header
    class="fixed top-0 left-0 w-full z-50"
  >
    <Navigation client:load />
  </header>

  <body>
    <slot />
  </body>
  <footer>
    <!-- Top -->
    <div class="border-t border-white/10">
      <div class="w-full h-full mx-auto px-5 max-w-5xl">
        <div class="flex items-center justify-between py-4">
          <p class="text-sm text-white/40">Andre Austria</p>
          <a onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <Button
              variant="outline"
              size="sm"
              className="rounded-full bg-transparent border-white/20 text-white hover:bg-white/10"
            >
              BACK TO TOP <ChevronUp/>
            </Button>
          </a>
        </div>
      </div>
    </div>
 
    <!-- Middle -->
    <div class="border-t border-white/10">
      <div class="w-full h-full mx-auto px-5 max-w-5xl">
        <div class="pt-8 pb-4">
          <p class="text-xs font-semibold tracking-wide text-white/40">
            HAVE A PROJECT IN MIND?
          </p>
 
          <div class="w-full flex items-center justify-start -mx-5 px-5 overflow-hidden">
            <h2
              class="select-none font-extrabold uppercase leading-[0.85] tracking-tight text-[18vw] sm:text-[13vw] lg:text-[9rem] text-transparent whitespace-nowrap"
              style="-webkit-text-stroke: 1px rgba(255,255,255,0.18); text-stroke: 1px rgba(255,255,255,0.18);"
            >
              Let&rsquo;s Talk
            </h2>
          </div>
        </div>
      </div>
    </div>
 
    <!-- Bottom -->
    <div class="border-t border-white/10">
      <div class="w-full h-full mx-auto px-5 max-w-6xl">
        <div class="flex items-center justify-center py-4">
          <p class="text-xs text-white/40 text-center">
            <a
              href=""
              class="hover:text-white transition-colors duration-300 ease-in-out"
            >
              Terms
            </a>
            <span class="mx-1">|</span>
            <a
              href=""
              class="hover:text-white transition-colors duration-300 ease-in-out"
            >
              Privacy Policy
            </a>
            <span class="mx-1">|</span>
            © {currentYear} Andre Austria. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </footer>
</html>
