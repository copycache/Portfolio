---
import "../styles/global.css";
import GuestLayout from "@/layouts/GuestLayout.astro";

import { Badge } from "@/components/ui/badge";

import { getExperiences } from "./api/work.ts";
const [experiences] = await Promise.all([getExperiences()]);
---

<GuestLayout content={{ title: "Work Experience | Andre Austria" }}>
  <div class="min-h-screen">
    <div class="mx-auto max-w-5xl px-5 pt-28 pb-20">

      <div class="mb-2">
        <p class="text-xs text-neutral-600 dark:text-neutral-400 uppercase tracking-widest mb-3">MY JOURNEY</p>
        <div class="flex items-center justify-between">
          <h1 class="text-3xl font-bold">Work Experience</h1>
          <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
            </span>
            Open to new opportunities
          </div>
        </div>
      </div>

      <div class="border-t border-zinc-800 mt-6 mb-12" />

      <div class="relative">
        <div class="absolute left-0 md:left-[108px] top-0 bottom-0 w-px bg-zinc-800"></div>

        <div class="space-y-16">
          {experiences.map((exp) => (
            <div class="relative flex gap-0">
              <div class="hidden md:block w-[108px] shrink-0 pt-1 text-right pr-6">
                <p class="text-xs leading-relaxed">
                  {exp.startDate}<br />{exp.endDate}
                </p>
              </div>

              <div class="relative shrink-0 w-0">
                {exp.status.variant === "current" && (
                  <div class="absolute -left-[4.5px] top-1.5 w-2.5 h-2.5 rounded-full bg-green-400 z-10"></div>
                )}
                {exp.status.variant !== "current" && (
                  <div class="absolute -left-[4.5px] top-1.5 w-2.5 h-2.5 rounded-full bg-zinc-600 border-2 border-zinc-900 z-10"></div>
                )}
              </div>

              <div class="pl-6 md:pl-8 flex-1 min-w-0">
                <p class="md:hidden text-xs text-neutral-600 dark:text-neutral-400 mb-1">
                  {exp.startDate} — {exp.endDate}
                </p>

                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h2 class="text-base font-semibold">{exp.title}</h2>
                </div>
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-sm text-neutral-600 dark:text-neutral-400">{exp.company}</span>
                  {exp.status.variant === "current" && (
                    <Badge variant="default" className="bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-300">{exp.status.label}</Badge>
                  )}
                  {exp.status.variant === "internship" && (
                    <Badge variant="secondary">{exp.status.label}</Badge>
                  )}
                </div>

                <ul class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4 max-w-2xl list-disc list-outside pl-5 space-y-1">
                  {exp.description.map((point: string) => (
                    <li>{point}</li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-2 mb-5">
                  {exp.techstack.map((skill) => (
                    <Badge variant="outline">{skill}</Badge>
                  ))}
                </div>

                <div class="flex gap-3 overflow-x-auto pb-1 -mx-1 px-1 sm:flex-wrap sm:overflow-visible">
                  {exp.images.map((img) => (
                    <div class="flex flex-col gap-1 shrink-0">
                      <div class="w-[120px] h-[80px] rounded overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                        <img
                          src={img.src}
                          alt={img.caption}
                          class="w-full h-full object-cover"
                          onerror="this.parentElement.classList.add('img-placeholder')"
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</GuestLayout>