---
import "../styles/global.css";
// Layout Imports
import GuestLayout from "@/layouts/GuestLayout.astro";

// UI Imports
import { Button } from "@/components/ui/button";
import { FileText, ArrowRight } from "lucide-react";

// Wrapper Imports
import Getintouchsection from "@/components/layouts/index/Getintouchsection.astro";
import Projectsection from "@/components/layouts/index/Projectsection.astro";
import Techstack from "@/components/layouts/index/Techstack.astro";
---

<GuestLayout content={{ title: "Home | Andre Austria" }}>
  <div>
    <!-- <div set:html={github.svg} /> -->
    <section class="grid place-items-center h-screen content-center">
      <div class="p-5 text-center">
        <p class="text-lg md:text-xl lg:text-2xl font-semibold opacity-75">
          Hello, I am
        </p>
        <p
          class="text-5xl md:text-6xl lg:text-7xl font-bold uppercase text-black dark:text-white"
        >
          Andre Austria
        </p>
        <p class="text-sm md:text-base lg:text-lg opacity-75">
          Junior IT Developer / Full Stack Developer
        </p>
      </div>

      <div class="flex flex-wrap gap-4 justify-center mt-5">
        <Button><FileText className="size-4" />Download CV</Button>
        <a href="#getInTouch"
          ><Button variant="outline"
            >Get in Touch<ArrowRight className="size-4" /></Button
          ></a
        >
      </div>
    </section>

    <div class="mx-auto max-w-5xl p-5 space-y-24">
      <p class="text-black sm:text-lg dark:text-white">
        Junior Full Stack Web Developer specializing in <span
          class="font-semibold"
        >
          TypeScript and JavaScript
        </span> with hands-on experience in <span class="font-semibold">
          React.js, Next.js, Vue.js/Nuxt.js, and Node.js
        </span>. Passionate about building <span class="font-semibold">
          responsive, user-friendly interfaces using Tailwind CSS, Bootstrap,
          shadcn/ui, and Radix UI
        </span>, and developing <span class="font-semibold">
          robust back-end solutions
        </span> with <span class="font-semibold">
          MySQL, Firebase, and Supabase
        </span>. Driven to create <span class="font-semibold">
          scalable, high-performance web applications
        </span> that deliver seamless user experiences.
      </p>

      <!-- Tech Stack Section -->
      <Techstack />
    </div>

    <!-- Projects Section -->
    <Projectsection />

    <!-- Get in Touch Section -->
    <Getintouchsection />
  </div>
</GuestLayout>
